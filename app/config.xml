<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tizen widget manifest.

  The `id` and `tizen:application` ids below are valid for sideloading in
  developer mode. Signing for the Tizen store requires a certificate whose
  package id matches `tizen:application/@package`.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/therosaer/SubTizen"
        version="0.1.0"
        viewmodes="maximized">

    <tizen:application id="therosaer.SubTizen"
                       package="therosaer"
                       required_version="2.4"/>

    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <name>SubTizen</name>
    <description>Subsonic client for Tizen TVs</description>

    <icon src="res/icon.png"/>
    <author href="https://github.com/therosaer"
            email="therosaer@users.noreply.github.com">therosaer</author>

    <!-- Required for XHR to arbitrary Subsonic servers -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>

    <!--
      Required for tizen.tvinputdevice.registerKey(). Without this privilege
      the registerKey() calls fail silently and media keys (play/pause/skip)
      are never delivered to the page at all.
    -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>

    <access origin="*" subdomains="true"/>

    <tizen:profile name="tv"/>
</widget>
